# GraphOS is used for build-time schema checks and artifact retrieval only.
APOLLO_GRAPH_REF=supergraph-federation@local
# Set APOLLO_KEY in your shell, macOS Keychain integration, or an untracked .env.
APOLLO_KEY=

SUPERGRAPH_ARTIFACT=router/artifacts/supergraph.graphql
SUPERGRAPH_PORT=4000
SUPERGRAPH_LISTEN=127.0.0.1:4000
PRODUCTS_URL=http://localhost:4001
TESTING_URL=http://localhost:4002

# Required by start-router.sh. Set this to the installed Apollo Router binary.
APOLLO_ROUTER_BIN=router